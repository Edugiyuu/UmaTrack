# Copy to .env and fill in.

# MongoDB. MONGODB_URI wins; without it the app builds the Atlas URL from DB_USER/DB_PASS.
# Point it at a local server while developing: "Try it out" in /docs writes to this database.
MONGODB_URI=mongodb://127.0.0.1:27017/umasprint
DB_USER=
DB_PASS=

# Secret used to sign the login JWT (HS256, 1 hour).
SECRET_KEY=

PORT=3000

# Swagger UI at /docs and the spec at /openapi.json. "true" or "false" forces them;
# unset, they are on except when NODE_ENV=production.
API_DOCS=true
# Server URL shown in the spec (the "Servers" dropdown of the Swagger UI).
PUBLIC_API_URL=http://localhost:3000
